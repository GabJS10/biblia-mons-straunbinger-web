---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Biblia Straubinger' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {/* Aplica el tema guardado ANTES del primer render para evitar el flash of
        wrong theme. `is:inline` deja el script tal cual en el <head> y bloquea
        el pintado hasta ejecutarse. */}
    <script is:inline>
      const t = localStorage.getItem('theme');
      document.documentElement.dataset.theme =
        t === 'light' || t === 'dark' || t === 'reading' ? t : 'light';
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>

---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import AuthWidget from '../components/AuthWidget.astro';

interface Props {
  title?: string;
}

const { title = 'Biblia Straubinger' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {/* Aplica el tema guardado ANTES del primer render para evitar el flash of
        wrong theme. `is:inline` deja el script tal cual en el <head> y bloquea
        el pintado hasta ejecutarse. */}
    <script is:inline>
      const t = localStorage.getItem('theme');
      document.documentElement.dataset.theme =
        t === 'light' || t === 'dark' || t === 'reading' ? t : 'light';

      /* Escala del texto de lectura: se aplica ANTES del primer render para que
         no haya salto de tamaño al cargar. Clave propia ('fontScale'),
         independiente del tema. Fallback a 1 si no existe o es inválida. */
      const fs = parseFloat(localStorage.getItem('fontScale'));
      if (fs >= 0.85 && fs <= 1.45) {
        document.documentElement.style.setProperty('--verse-font-scale', String(fs));
      }
    </script>
  </head>
  <body>
    <ThemeToggle />
    <AuthWidget />
    <slot />
  </body>
</html>

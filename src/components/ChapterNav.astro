---
/**
 * Navegación anterior/siguiente de lectura (Paso 6c). Reemplaza los botones que
 * antes vivían en `ReaderHeader` (Paso 4).
 *
 * Renderiza DOS patrones, alternados solo con CSS (media query en `64rem`, sin
 * JS):
 *   - Anchas (≥ 64rem): dos flechas circulares finas `position: fixed`,
 *     centradas verticalmente y pegadas a los bordes de la ventana, dentro del
 *     gutter que deja la columna de lectura (max-width 44rem). Solo ícono; el
 *     nombre del destino va en `title` + `aria-label`.
 *   - Angostas (< 64rem): las flechas fijas se ocultan y, al final del flujo
 *     (después de `FootnotesSection`, porque este componente se coloca tras
 *     `ChapterReader`), aparece una barra con flecha + nombre del destino, mismo
 *     formato que la nav del header del Paso 4 (con ellipsis si el nombre no
 *     cabe).
 *
 * `prev`/`next` son opcionales: si son `null` (extremos de la secuencia, que
 * `readingSequence.ts` ya resuelve) el botón correspondiente no se renderiza en
 * ninguno de los dos patrones —sin hueco ni espacio reservado—.
 *
 * Las flechas son `position: fixed` (contenido normal): cuando el
 * `BookPickerModal` se abre con `.showModal()`, su `::backdrop` en el top layer
 * las cubre y deja la página inerte, igual que al `ThemeToggle`. No requiere
 * lógica extra.
 */
import type { SequenceNode } from '../lib/readingSequence';

interface Props {
  prev: SequenceNode | null;
  next: SequenceNode | null;
}

const { prev, next } = Astro.props as Props;
---

{
  (prev || next) && (
    <nav class="chapter-nav" aria-label="Navegación de lectura">
      {/* --- Patrón anchas: flechas fijas en los bordes (solo ícono) --- */}
      {prev && (
        <a
          class="edge-arrow edge-prev"
          href={prev.url}
          rel="prev"
          title={prev.label}
          aria-label={`Ir a ${prev.label}`}
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="15 18 9 12 15 6" />
          </svg>
        </a>
      )}
      {next && (
        <a
          class="edge-arrow edge-next"
          href={next.url}
          rel="next"
          title={next.label}
          aria-label={`Ir a ${next.label}`}
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="9 18 15 12 9 6" />
          </svg>
        </a>
      )}

      {/* --- Patrón angostas: barra al final (flecha + nombre) --- */}
      <div class="bar-nav">
        {prev && (
          <a class="bar-btn bar-prev" href={prev.url} rel="prev">
            <span class="bar-arrow" aria-hidden="true">←</span>
            <span class="bar-label">{prev.label}</span>
          </a>
        )}
        {next && (
          <a class="bar-btn bar-next" href={next.url} rel="next">
            <span class="bar-label">{next.label}</span>
            <span class="bar-arrow" aria-hidden="true">→</span>
          </a>
        )}
      </div>
    </nav>
  )
}

<style>
  /* ---------- Patrón anchas: flechas fijas ---------- */
  /* Ocultas por defecto (mobile-first); el media query las activa. */
  .edge-arrow {
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
    z-index: 40; /* bajo el ThemeToggle (50); no se solapan de todos modos */
    display: none;
    place-items: center;
    width: 3rem;
    height: 3rem;
    color: var(--text-secondary);
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: 50%;
    transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
  }
  .edge-prev {
    left: 1.5rem;
  }
  .edge-next {
    right: 1.5rem;
  }
  .edge-arrow:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .edge-arrow:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .edge-arrow svg {
    width: 1.4rem;
    height: 1.4rem;
  }

  /* ---------- Patrón angostas: barra al final ---------- */
  .bar-nav {
    display: flex;
    gap: 0.75rem;
    margin-top: 3rem;
  }

  .bar-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    flex: 1 1 0; /* dos presentes → 50/50; uno solo → ancho completo */
    min-width: 0;
    min-height: 2.75rem; /* área táctil cómoda (~44px) */
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--text);
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: 2px;
    padding: 0.6rem 0.9rem;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .bar-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .bar-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .bar-next {
    justify-content: flex-end;
    text-align: right;
  }

  /* La flecha siempre visible; el nombre se trunca con ellipsis si no cabe. */
  .bar-arrow {
    flex: none;
    color: var(--accent);
  }
  .bar-label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* ---------- Alternancia de patrones (un solo breakpoint, mutuamente
       excluyentes: nunca ambos ni ninguno) ---------- */
  @media (min-width: 64rem) {
    .edge-arrow {
      display: grid;
    }
    .bar-nav {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .edge-arrow,
    .bar-btn {
      transition: none;
    }
  }
</style>

---
/**
 * Cabecera compartida de las páginas del lector (capítulo, introducción,
 * prólogo). Reemplaza el header mínimo ad-hoc del Paso 3.
 *
 * Incluye el `BookPickerModal` (alimentado con el catálogo completo) para que
 * el botón "Elegir libro" pueda reabrirlo desde cualquier página del lector.
 *
 * `prev`/`next` son opcionales: si no se pasan (o son null) el botón
 * correspondiente no se renderiza —no queda deshabilitado ni deja hueco—. El
 * prólogo usa esta cabecera sin `prev`/`next`.
 */
import BookPickerModal from './BookPickerModal.astro';
import { getBookCatalog } from '../lib/bookCatalog';
import type { SequenceNode } from '../lib/readingSequence';

interface Props {
  eyebrow: string;
  title: string;
  prev?: SequenceNode | null;
  next?: SequenceNode | null;
}

const { eyebrow, title, prev = null, next = null } = Astro.props;
const books = await getBookCatalog();
---

<header class="reader-header">
  <div class="reader-topline">
    <div class="reader-heading">
      <p class="reader-eyebrow">{eyebrow}</p>
      <h1 class="reader-title">{title}</h1>
    </div>
    <button type="button" class="btn-picker" data-open-picker>Elegir libro</button>
  </div>

  {
    (prev || next) && (
      <nav class="reader-nav" aria-label="Navegación de lectura">
        {prev ? (
          <a class="nav-btn nav-prev" href={prev.url} rel="prev">
            <span class="nav-arrow" aria-hidden="true">←</span>
            <span class="nav-label">{prev.label}</span>
          </a>
        ) : (
          <span class="nav-spacer" aria-hidden="true" />
        )}
        {next ? (
          <a class="nav-btn nav-next" href={next.url} rel="next">
            <span class="nav-label">{next.label}</span>
            <span class="nav-arrow" aria-hidden="true">→</span>
          </a>
        ) : (
          <span class="nav-spacer" aria-hidden="true" />
        )}
      </nav>
    )
  }
</header>

<BookPickerModal books={books} />

<style>
  .reader-header {
    margin-bottom: 2rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid color-mix(in srgb, var(--text-secondary) 25%, transparent);
  }

  .reader-topline {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .reader-heading {
    text-align: left;
    min-width: 0;
  }

  .reader-eyebrow {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin: 0 0 0.35rem;
  }

  .reader-title {
    font-family: var(--font-sans);
    font-size: clamp(1.6rem, 5vw, 2.2rem);
    font-weight: 600;
    color: var(--text);
    margin: 0;
  }

  .btn-picker {
    flex: none;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent);
    background: transparent;
    border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
    border-radius: 999px;
    padding: 0.45rem 1.1rem;
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .btn-picker:hover {
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    border-color: var(--accent);
  }

  /* --- Navegación anterior/siguiente --- */
  .reader-nav {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  /* Reserva el lado vacío cuando falta prev o next, para que el botón presente
     quede en su extremo sin ocupar todo el ancho. */
  .nav-spacer {
    flex: 1 1 0;
  }

  .nav-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    flex: 1 1 0;
    min-width: 0;
    max-width: 50%;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--text);
    background: color-mix(in srgb, var(--text-secondary) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--text-secondary) 25%, transparent);
    border-radius: 8px;
    padding: 0.6rem 0.9rem;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .nav-btn:hover {
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    border-color: var(--accent);
  }
  .nav-next {
    margin-left: auto;
    justify-content: flex-end;
    text-align: right;
  }

  /* La flecha siempre visible; el nombre se trunca con ellipsis si no cabe. */
  .nav-arrow {
    flex: none;
    color: var(--accent);
  }
  .nav-label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .btn-picker,
    .nav-btn {
      transition: none;
    }
  }
</style>

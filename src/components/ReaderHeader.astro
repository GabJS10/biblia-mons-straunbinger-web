---
/**
 * Cabecera compartida de las páginas del lector (capítulo, introducción,
 * prólogo). Reemplaza el header mínimo ad-hoc del Paso 3.
 *
 * Incluye el `BookPickerModal` (alimentado con el catálogo completo) para que
 * el botón "Elegir libro" pueda reabrirlo desde cualquier página del lector, y
 * un botón de inicio que enlaza a `/`.
 *
 * La navegación anterior/siguiente ya NO vive aquí: se movió a `ChapterNav`
 * (Paso 6c), que las páginas de capítulo/introducción renderizan aparte.
 */
import BookPickerModal from './BookPickerModal.astro';
import FontSizeControl from './FontSizeControl.astro';
import { getBookCatalog } from '../lib/bookCatalog';

interface Props {
  eyebrow: string;
  title: string;
}

const { eyebrow, title } = Astro.props;
const books = await getBookCatalog();
---

<header class="reader-header">
  <div class="reader-topline">
    <div class="reader-lead">
      <div class="reader-heading">
        <p class="reader-eyebrow">{eyebrow}</p>
        <h1 class="reader-title">{title}</h1>
      </div>
    </div>
    <div class="reader-actions">
      <a class="btn-home" href="/" aria-label="Ir al inicio">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 10.5 12 3l9 7.5" />
          <path d="M5 9.5V20a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1V9.5" />
        </svg>
      </a>
      <FontSizeControl />
      <button type="button" class="btn-picker" data-open-picker>Elegir libro</button>
    </div>
  </div>
</header>

<BookPickerModal books={books} />

<style>
  .reader-header {
    margin-bottom: 2.75rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--border);
  }

  .reader-topline {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    /* Con el control A- / A+ sumado a los otros botones, en anchos intermedios
       el cluster de acciones puede envolver bajo el encabezado sin apretarse. */
    flex-wrap: wrap;
  }

  /* En pantallas donde el contenido ocupa casi todo el ancho, las acciones
     quedan al borde derecho, justo donde flota el ThemeToggle. Se reserva
     espacio a la derecha para que no se solapen. */
  @media (max-width: 48rem) {
    .reader-topline {
      padding-right: 3rem;
    }
  }

  /* Cluster derecho: inicio + tamaño de texto + elegir libro. Envuelve como
     bloque en móvil manteniéndose alineado a la derecha. */
  .reader-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex: none;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  /* Cluster izquierdo: botón de inicio + encabezado, agrupados. */
  .reader-lead {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    min-width: 0;
    flex: 1 1 auto;
  }

  /* Botón de inicio: ícono de contorno, sin recuadro; área táctil ~44px.
     Vive en el cluster derecho `.reader-actions`, junto al control de tamaño y
     "Elegir libro". */
  .btn-home {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    color: var(--text-secondary);
    transition: color 0.15s ease;
  }
  .btn-home:hover {
    color: var(--accent);
  }
  .btn-home:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 2px;
  }
  .btn-home svg {
    width: 1.4rem;
    height: 1.4rem;
  }

  .reader-heading {
    text-align: left;
    min-width: 0;
  }

  .reader-eyebrow {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin: 0 0 0.35rem;
  }

  .reader-title {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 5.5vw, 2.6rem);
    font-weight: 600;
    line-height: 1.1;
    color: var(--text);
    margin: 0;
  }

  /* Botón de acción con estilo de CONTORNO (no píldora rellena). */
  .btn-picker {
    flex: none;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem; /* área táctil cómoda en móvil (~44px) */
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    background: transparent;
    border: 1px solid var(--accent);
    border-radius: 2px;
    padding: 0.5rem 1.1rem;
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .btn-picker:hover {
    background: var(--accent);
    color: var(--bg);
  }
  .btn-picker:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .btn-picker,
    .btn-home {
      transition: none;
    }
  }
</style>

---
/**
 * Renderiza el contenido de un capítulo fusionando divisiones del libro,
 * secciones editoriales y versículos en un único flujo (ver `buildChapterFlow`),
 * seguido de la sección de notas al pie del capítulo.
 *
 * Niveles de encabezado: las divisiones (estructurales) son más prominentes
 * (`h2`) que las secciones (subtítulos editoriales, `h3`).
 *
 * Todo el texto se trata como prosa por ahora (sin formato poético).
 */
import { buildChapterFlow, type BookData, type Chapter } from '../lib/chapterFlow';
import Verse from './Verse.astro';
import FootnotesSection from './FootnotesSection.astro';

interface Props {
  book: BookData;
  chapter: Chapter;
  /** Slug de la ruta (`entry.id`) y id del capítulo — los usa el script de
   *  resaltado para saber en qué libro/capítulo está parado. */
  bookSlug: string;
  chapterId: string;
}

const { book, chapter, bookSlug, chapterId } = Astro.props;
const { items, referencedNotes } = buildChapterFlow(book, chapter);

// Índice del PRIMER versículo del flujo: recibe la letra capitular, aunque antes
// haya encabezados de división/sección (la versal va en el primer versículo, no
// en el primer carácter visible de la página).
const firstVerseIndex = items.findIndex((item) => item.kind === 'verse');
---

<article
  class="chapter"
  data-book-slug={bookSlug}
  data-book-name={book.book}
  data-chapter-id={chapterId}
>
  {
    items.map((item, index) => {
      if (item.kind === 'division') {
        return <h2 class="division">{item.title}</h2>;
      }
      if (item.kind === 'section') {
        return <h3 class="section">{item.title}</h3>;
      }
      return (
        <Verse
          number={item.verse.number}
          text={item.verse.text}
          notes={item.notes}
          dropcap={index === firstVerseIndex}
        />
      );
    })
  }

  <FootnotesSection notes={referencedNotes} />
</article>

<style>
  .chapter {
    /* Prosa continua: los versículos fluyen dentro del mismo bloque. */
    font-family: var(--font-body);
    /* El cuerpo escala con la preferencia del usuario (A- / A+). La versal
       (.dropcap) queda fija en 4rem —ver Verse.astro—, no hereda esta escala. */
    font-size: calc(1.25rem * var(--verse-font-scale));
    line-height: 1.8;
    color: var(--text);
    text-align: justify;
    hyphens: auto;
  }

  /* Los versículos son inline dentro del flujo de prosa, separados por espacio. */
  .chapter :global(.verse) {
    display: inline;
  }
  .chapter :global(.verse) + :global(.verse)::before {
    content: ' ';
  }

  /* Versículo resaltado: lavado translúcido de acento (funciona en los 3 temas
     vía color-mix sobre --accent). `box-decoration-break: clone` reparte el
     fondo y el padding por cada fragmento de línea, sin cajas rotas al envolver.
     La versal (float) queda fuera del fondo inline: el acento fuerte de la letra
     capitular ya lee como parte del resaltado, sin ensuciarse. */
  .chapter :global(.verse.is-highlighted) {
    background: color-mix(in srgb, var(--accent) 15%, transparent);
    padding: 0.05em 0.12em;
    margin: 0 -0.12em;
    border-radius: 2px;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    cursor: pointer;
  }

  /* División: encabezado estructural prominente (números romanos del libro). */
  .division {
    font-family: var(--font-display);
    font-size: 1.55rem;
    font-weight: 600;
    color: var(--text);
    text-align: left;
    margin: 2.75rem 0 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }
  .division:first-child {
    margin-top: 0;
  }

  /* Sección: subtítulo editorial menor. */
  .section {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 500;
    font-style: italic;
    color: var(--text-secondary);
    text-align: left;
    margin: 1.75rem 0 0.75rem;
  }
  .section:first-child {
    margin-top: 0;
  }
</style>

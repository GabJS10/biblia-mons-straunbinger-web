---
/**
 * Renderiza el contenido de un capítulo fusionando divisiones del libro,
 * secciones editoriales y versículos en un único flujo (ver `buildChapterFlow`),
 * seguido de la sección de notas al pie del capítulo.
 *
 * Niveles de encabezado: las divisiones (estructurales) son más prominentes
 * (`h2`) que las secciones (subtítulos editoriales, `h3`).
 *
 * Todo el texto se trata como prosa por ahora (sin formato poético).
 */
import { buildChapterFlow, type BookData, type Chapter } from '../lib/chapterFlow';
import Verse from './Verse.astro';
import FootnotesSection from './FootnotesSection.astro';

interface Props {
  book: BookData;
  chapter: Chapter;
}

const { book, chapter } = Astro.props;
const { items, referencedNotes } = buildChapterFlow(book, chapter);

// Índice del PRIMER versículo del flujo: recibe la letra capitular, aunque antes
// haya encabezados de división/sección (la versal va en el primer versículo, no
// en el primer carácter visible de la página).
const firstVerseIndex = items.findIndex((item) => item.kind === 'verse');
---

<article class="chapter">
  {
    items.map((item, index) => {
      if (item.kind === 'division') {
        return <h2 class="division">{item.title}</h2>;
      }
      if (item.kind === 'section') {
        return <h3 class="section">{item.title}</h3>;
      }
      return (
        <Verse
          number={item.verse.number}
          text={item.verse.text}
          notes={item.notes}
          dropcap={index === firstVerseIndex}
        />
      );
    })
  }

  <FootnotesSection notes={referencedNotes} />
</article>

<style>
  .chapter {
    /* Prosa continua: los versículos fluyen dentro del mismo bloque. */
    font-family: var(--font-body);
    font-size: 1.25rem;
    line-height: 1.8;
    color: var(--text);
    text-align: justify;
    hyphens: auto;
  }

  /* Los versículos son inline dentro del flujo de prosa, separados por espacio. */
  .chapter :global(.verse) {
    display: inline;
  }
  .chapter :global(.verse) + :global(.verse)::before {
    content: ' ';
  }

  /* División: encabezado estructural prominente (números romanos del libro). */
  .division {
    font-family: var(--font-display);
    font-size: 1.55rem;
    font-weight: 600;
    color: var(--text);
    text-align: left;
    margin: 2.75rem 0 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }
  .division:first-child {
    margin-top: 0;
  }

  /* Sección: subtítulo editorial menor. */
  .section {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 500;
    font-style: italic;
    color: var(--text-secondary);
    text-align: left;
    margin: 1.75rem 0 0.75rem;
  }
  .section:first-child {
    margin-top: 0;
  }
</style>

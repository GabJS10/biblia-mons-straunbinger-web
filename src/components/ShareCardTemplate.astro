---
/**
 * Plantilla de la tarjeta compartible (Paso 10).
 *
 * Nodo oculto fuera de pantalla que `src/lib/shareCard.ts` reutiliza para
 * rasterizar (con `html-to-image`) un resaltado como PNG. Se incluye UNA sola
 * vez en `/mis-resaltados/`; su contenido (cita + referencia) se reescribe
 * antes de cada captura y su formato (cuadrado/historia) se cambia con la clase
 * modificadora, así el mismo nodo sirve para cualquier resaltado.
 *
 * IDENTIDAD VISUAL FIJA: la tarjeta NO depende del tema activo del sitio. Sus
 * colores (negro, dorado, crema, gris) están escritos a mano aquí y NO usan las
 * variables `var(--…)` de themes.css: una tarjeta para compartir debe verse
 * igual la generó quien la generó en modo claro, oscuro o lectura. Las FUENTES
 * sí reutilizan `var(--font-*)` porque son globales y no cambian con el tema.
 *
 * POSICIONAMIENTO: se deja fuera del viewport pero VISIBLE, nunca con
 * `display:none`/`visibility:hidden`, porque esos métodos impiden que el
 * navegador calcule layout/scrollHeight (necesario para el auto-ajuste del
 * punto 4) y pueden hacer que html-to-image capture vacío.
 *
 * IMPORTANTE: el offset off-screen vive en el WRAPPER `.share-card-stage`, NO en
 * `.share-card`. html-to-image clona el nodo capturado copiando sus estilos
 * computados dentro de un <foreignObject>; si el propio nodo capturado llevara
 * `left: -9999px`, ese offset se copiaría y empujaría el contenido fuera del
 * lienzo → PNG transparente. Por eso `.share-card` (el nodo capturado) va en el
 * origen y solo el wrapper padre —que NO se captura— se saca de pantalla.
 */
---

<div class="share-card-stage" aria-hidden="true">
  <div class="share-card share-card--square" data-share-card>
    <div class="share-card-inner" data-share-card-inner>
      <div class="share-card-quote" aria-hidden="true">&#8220;</div>
      <p class="share-card-text" data-share-card-text></p>
      <div class="share-card-rule" aria-hidden="true"></div>
      <p class="share-card-ref" data-share-card-ref></p>
    </div>
    <p class="share-card-wordmark">Biblia Straubinger</p>
  </div>
</div>

<style>
  /* Wrapper fuera del viewport pero renderizado (ver comentario del front
     matter). El offset off-screen vive AQUÍ, no en el nodo capturado. */
  .share-card-stage {
    position: fixed;
    top: 0;
    left: -99999px;
    z-index: -1;
  }

  /* Nodo capturado por html-to-image: en el origen (sin offset), pero posicionado
     (relative) para servir de ancestro a `.share-card-inner` y `.share-card-wordmark`
     (absolutos). Tamaño real en px: la captura es 1:1 con pixelRatio 1. */
  .share-card {
    position: relative;
    box-sizing: border-box;
    background: #000000;
    color: #f2f0e8;
    overflow: hidden;
  }
  .share-card *,
  .share-card *::before,
  .share-card *::after {
    box-sizing: border-box;
  }

  /* ---- Formato cuadrado (post 1080×1080) ---- */
  .share-card--square {
    width: 1080px;
    height: 1080px;
  }
  /* Área de contenido: del padding superior hasta encima del wordmark. Altura
     FIJA (top/bottom absolutos) → su clientHeight es constante y el auto-ajuste
     compara scrollHeight contra él para detectar desborde. */
  .share-card--square .share-card-inner {
    top: 108px;
    right: 108px;
    bottom: 150px;
    left: 108px;
  }
  .share-card--square .share-card-quote {
    font-size: 150px;
    line-height: 0.8;
    margin-bottom: 28px;
  }
  .share-card--square .share-card-text {
    font-size: 2.9rem;
  }
  .share-card--square .share-card-rule {
    margin: 44px 0;
  }
  .share-card--square .share-card-ref {
    font-size: 1.9rem;
  }
  .share-card--square .share-card-wordmark {
    bottom: 74px;
    font-size: 22px;
  }

  /* ---- Formato historia (story 1080×1920) — texto algo más grande ---- */
  .share-card--story {
    width: 1080px;
    height: 1920px;
  }
  .share-card--story .share-card-inner {
    top: 120px;
    right: 120px;
    bottom: 200px;
    left: 120px;
  }
  .share-card--story .share-card-quote {
    font-size: 176px;
    line-height: 0.8;
    margin-bottom: 34px;
  }
  .share-card--story .share-card-text {
    font-size: 3.4rem;
  }
  .share-card--story .share-card-rule {
    margin: 56px 0;
  }
  .share-card--story .share-card-ref {
    font-size: 2.2rem;
  }
  .share-card--story .share-card-wordmark {
    bottom: 104px;
    font-size: 24px;
  }

  /* Bloque de contenido centrado. Altura fija por las cuatro anclas absolutas;
     overflow oculto para que un pasaje largo (antes del auto-ajuste) no rompa
     el diseño mientras se mide. */
  .share-card-inner {
    position: absolute;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
  }

  /* Comilla decorativa — Fraunces 600, dorado. */
  .share-card-quote {
    font-family: var(--font-display);
    font-weight: 600;
    color: #d4a72c;
  }

  /* Cita — EB Garamond itálica, crema, interlineado generoso. El font-size base
     lo fija el formato; el auto-ajuste (shareCard.ts) lo sobrescribe inline si
     el pasaje se desborda. */
  .share-card-text {
    margin: 0;
    font-family: var(--font-body);
    font-style: italic;
    font-weight: 400;
    line-height: 1.5;
    color: #f2f0e8;
  }

  /* Línea separadora dorada fina. */
  .share-card-rule {
    width: 56px;
    height: 1px;
    background: #d4a72c;
    flex: none;
  }

  /* Referencia — Fraunces medium, dorado. */
  .share-card-ref {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    color: #d4a72c;
  }

  /* Wordmark — Inter, mayúsculas, tracking amplio, gris discreto, junto al borde
     inferior. Centrado horizontalmente vía left/right 0 + text-align. */
  .share-card-wordmark {
    position: absolute;
    left: 0;
    right: 0;
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: #7a766c;
    text-align: center;
  }
</style>

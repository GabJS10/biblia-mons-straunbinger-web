---
/**
 * Modal de selección de libro / capítulo (inspirado en bible.com).
 *
 * Usa el <dialog> nativo (.showModal() / .close()) y TypeScript vanilla.
 * Se abre desde cualquier elemento con el atributo `data-open-picker`.
 *
 * Los libros se renderizan en build time (dos grids, uno por testamento).
 * Los capítulos NO se renderizan de antemano (Salmos tiene 152): se construyen
 * en el cliente al pulsar un libro, a partir de los data-attributes del botón.
 */
// El tipo vive en el catálogo compartido; se re-exporta por conveniencia.
import type { BookItem } from "../lib/bookCatalog";
export type { BookItem };

interface Props {
  books: BookItem[];
}

const { books } = Astro.props;
const at = books.filter((b) => b.testament === "AT");
const nt = books.filter((b) => b.testament === "NT");
---

<dialog id="book-picker" data-view="books" aria-label="Seleccionar libro y capítulo">
  <div class="modal-shell">
    <header class="modal-header">
      <!-- Cabecera de la vista de libros: pestañas por testamento. -->
      <div class="tabs" role="tablist" aria-label="Testamento">
        <button type="button" class="tab is-active" data-tab="AT" role="tab" aria-selected="true">
          Antiguo Testamento
        </button>
        <button type="button" class="tab" data-tab="NT" role="tab" aria-selected="false">
          Nuevo Testamento
        </button>
      </div>
      <!-- Cabecera de la vista de capítulos: volver + título del libro. -->
      <button type="button" class="btn-back" data-back>
        <span aria-hidden="true">←</span> Volver a libros
      </button>
      <h2 class="chapters-title" data-chapters-title></h2>

      <button type="button" class="btn-close" data-close aria-label="Cerrar">✕</button>
    </header>

    <!-- Vista: libros -->
    <section class="view view-books" data-active="AT">
      <div class="book-grid" data-testament="AT">
        {
          at.map((b) => (
            <button
              type="button"
              class="book-btn"
              data-slug={b.slug}
              data-name={b.name}
              data-chapters={b.chapterIds.join(",")}
              data-intro={b.hasIntro ? "1" : "0"}
            >
              {b.name}
            </button>
          ))
        }
      </div>
      <div class="book-grid" data-testament="NT" hidden>
        {
          nt.map((b) => (
            <button
              type="button"
              class="book-btn"
              data-slug={b.slug}
              data-name={b.name}
              data-chapters={b.chapterIds.join(",")}
              data-intro={b.hasIntro ? "1" : "0"}
            >
              {b.name}
            </button>
          ))
        }
      </div>
    </section>

    <!-- Vista: capítulos (grid poblado en el cliente) -->
    <section class="view view-chapters">
      <div class="chapter-grid" data-chapter-grid></div>
    </section>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("#book-picker");
  if (dialog) {
    const viewBooks = dialog.querySelector<HTMLElement>(".view-books")!;
    const chaptersTitle = dialog.querySelector<HTMLElement>("[data-chapters-title]")!;
    const chapterGrid = dialog.querySelector<HTMLElement>("[data-chapter-grid]")!;

    // --- Abrir / cerrar ---
    document.querySelectorAll<HTMLElement>("[data-open-picker]").forEach((opener) => {
      opener.addEventListener("click", () => dialog.showModal());
    });

    dialog.querySelector("[data-close]")?.addEventListener("click", () => dialog.close());

    // Click en el backdrop (fuera del contenido) cierra el modal.
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });

    // Al cerrar, volver siempre a la vista de libros y al AT.
    dialog.addEventListener("close", () => {
      dialog.dataset.view = "books";
      viewBooks.dataset.active = "AT";
      syncTabs("AT");
    });

    // --- Pestañas de testamento ---
    const tabs = dialog.querySelectorAll<HTMLButtonElement>(".tab");
    function syncTabs(active: string) {
      tabs.forEach((t) => {
        const isActive = t.dataset.tab === active;
        t.classList.toggle("is-active", isActive);
        t.setAttribute("aria-selected", String(isActive));
      });
    }
    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const active = tab.dataset.tab!;
        viewBooks.dataset.active = active;
        syncTabs(active);
      });
    });

    // --- Libro -> capítulos ---
    viewBooks.addEventListener("click", (event) => {
      const btn = (event.target as HTMLElement).closest<HTMLElement>(".book-btn");
      if (!btn) return;
      const { slug, name, chapters, intro } = btn.dataset;
      chaptersTitle.textContent = name ?? "";
      chapterGrid.innerHTML = "";

      if (intro === "1") {
        const link = document.createElement("a");
        link.href = `/${slug}/introduccion/`;
        link.className = "chapter-cell chapter-cell--intro";
        link.textContent = "Intro";
        chapterGrid.appendChild(link);
      }

      // `chapters` es la lista de ids separada por comas ("1,2,…" o con
      // etiquetas como "9a,9b"). Cada id es a la vez el texto de la celda y el
      // segmento de la ruta /[slug]/[id]/.
      const ids = (chapters ?? "").split(",").filter(Boolean);
      for (const id of ids) {
        const link = document.createElement("a");
        link.href = `/${slug}/${id}/`;
        link.className = "chapter-cell";
        link.textContent = id;
        chapterGrid.appendChild(link);
      }

      dialog.dataset.view = "chapters";
    });

    // --- Volver a libros ---
    dialog.querySelector("[data-back]")?.addEventListener("click", () => {
      dialog.dataset.view = "books";
    });
  }
</script>

<style>
  /* ---------- Diálogo / backdrop ---------- */
  dialog {
    padding: 0;
    border: none;
    background: transparent;
    max-width: 100%;
    max-height: 100%;
    width: 100%;
    height: 100%;
    color: var(--text);
  }

  dialog::backdrop {
    background: rgba(0, 0, 0, 0.5);
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  /* Contenedor visible: casi pantalla completa, con márgenes en desktop. */
  .modal-shell {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    max-width: 60rem;
    margin: 0 auto;
    background: var(--bg);
    font-family: var(--font-sans);
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  @media (min-width: 40rem) {
    dialog {
      padding: 2rem 1rem;
    }
    .modal-shell {
      height: auto;
      max-height: 100%;
      border-radius: 12px;
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.25);
      overflow: hidden;
    }
  }

  /* Animación de entrada (native dialog + @starting-style). */
  dialog[open]::backdrop {
    opacity: 1;
  }
  dialog[open] .modal-shell {
    opacity: 1;
    transform: none;
  }
  @starting-style {
    dialog[open]::backdrop {
      opacity: 0;
    }
    dialog[open] .modal-shell {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  /* ---------- Cabecera ---------- */
  .modal-header {
    position: sticky;
    top: 0;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }

  .tabs {
    display: flex;
    gap: 0.5rem;
    flex: 1;
  }

  .tab {
    flex: 1;
    min-height: 2.75rem; /* área táctil cómoda en móvil (~44px) */
    padding: 0.6rem 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-secondary);
    background: transparent;
    border: none;
    border-bottom: 1px solid transparent;
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .tab:hover {
    color: var(--text);
  }
  .tab.is-active {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .btn-back {
    flex: 1;
    display: none;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 0.25rem;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    background: transparent;
    border: none;
    cursor: pointer;
    text-align: left;
  }

  .chapters-title {
    display: none;
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--text);
  }

  .btn-close {
    display: grid;
    place-items: center;
    width: 2.75rem; /* área táctil cómoda en móvil (~44px) */
    height: 2.75rem;
    flex: none;
    font-size: 1rem;
    color: var(--text-secondary);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 2px;
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .btn-close:hover {
    color: var(--text);
    border-color: var(--text-secondary);
  }

  /* ---------- Vistas (libros / capítulos) ---------- */
  .view {
    padding: 1rem;
    overflow-y: auto;
    animation: fade-in 0.2s ease;
  }

  /* Alternancia de vistas según data-view del <dialog>. */
  dialog[data-view="books"] .view-chapters {
    display: none;
  }
  dialog[data-view="chapters"] .view-books {
    display: none;
  }

  /* En capítulos: ocultar pestañas, mostrar volver + título. */
  dialog[data-view="chapters"] .tabs {
    display: none;
  }
  dialog[data-view="chapters"] .btn-back {
    display: flex;
  }
  dialog[data-view="chapters"] .chapters-title {
    display: block;
    flex: 1;
  }

  /* Alternancia de grids por testamento. */
  .view-books[data-active="AT"] .book-grid[data-testament="NT"],
  .view-books[data-active="NT"] .book-grid[data-testament="AT"] {
    display: none;
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  /* ---------- Vista de libros: índice tipográfico ---------- */
  /* Sin cajas por celda: cada libro es texto plano en Fraunces, separado por un
     hairline inferior —como un índice de libro impreso—. El área clickeable la
     da el padding, no un fondo; el foco de teclado usa un anillo propio porque
     ya no hay borde que lo enmarque. */
  .book-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
    column-gap: 2.5rem;
    row-gap: 0;
  }

  .book-btn {
    padding: 0.7rem 0.25rem;
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 500;
    text-align: left;
    color: var(--text);
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--border);
    border-radius: 0;
    cursor: pointer;
    transition: color 0.15s ease;
  }
  .book-btn:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  .book-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 2px;
  }

  /* ---------- Vista de capítulos: cuadrícula de números ---------- */
  /* Números en var(--font-sans): a la densidad de Salmos (152 celdas) el sans se
     lee más limpio y parejo que la serif de display. Sin cajas: la celda
     conserva su tamaño (aspect-ratio) como área táctil generosa, pero el fondo/
     borde desaparece; hover y foco se resuelven con color y anillo. */
  .chapter-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(3.25rem, 1fr));
    gap: 0.25rem;
  }

  .chapter-cell {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    font-family: var(--font-sans);
    font-size: 1.05rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--text);
    background: transparent;
    border: none;
    border-radius: 2px;
    transition: color 0.15s ease;
  }
  .chapter-cell:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  .chapter-cell:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  /* Celda "Introducción": ocupa toda la fila y se distingue de los números con
     itálica en Fraunces (no un recuadro). */
  .chapter-cell--intro {
    grid-column: 1 / -1;
    aspect-ratio: auto;
    place-items: center start;
    padding: 0.7rem 0.25rem;
    margin-bottom: 0.25rem;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: 1.2rem;
    color: var(--accent);
    border-bottom: 1px solid var(--border);
  }
  .chapter-cell--intro:hover {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  /* Respeta la preferencia de reducir movimiento. */
  @media (prefers-reduced-motion: reduce) {
    .modal-shell,
    dialog::backdrop,
    .view,
    .book-btn,
    .chapter-cell {
      transition: none;
      animation: none;
    }
  }
</style>

---
/**
 * Página "Mis resaltados": `/mis-resaltados/`.
 *
 * Shell estático (header simple + botón de inicio) que monta la isla
 * `HighlightsManager`, donde vive toda la lógica de datos y UI. NO hay
 * protección a nivel de ruta: el sitio sigue siendo estático y el componente
 * resuelve el estado de sesión en el cliente.
 *
 * El mapa slug → nombre visible del libro se calcula en build time desde el
 * catálogo canónico (`getBookCatalog`) y se pasa al componente para render las
 * referencias legibles ("Génesis 1:3") sin hardcodear un mapeo nuevo.
 */
import Layout from '../../layouts/Layout.astro';
import HighlightsManager from '../../components/HighlightsManager.astro';
import ShareCardTemplate from '../../components/ShareCardTemplate.astro';
import { getBookCatalog } from '../../lib/bookCatalog';

const catalog = await getBookCatalog();
const bookNames: Record<string, string> = Object.fromEntries(
  catalog.map((b) => [b.slug, b.name]),
);
---

<Layout title="Mis resaltados — Biblia Straubinger">
  <div class="page">
    <header class="page-header">
      <a class="btn-home" href="/" aria-label="Ir al inicio">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 10.5 12 3l9 7.5" />
          <path d="M5 9.5V20a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1V9.5" />
        </svg>
      </a>
      <h1 class="page-title">Mis resaltados</h1>
    </header>

    <HighlightsManager bookNames={bookNames} />
  </div>

  {/* Plantilla de la tarjeta compartible: UNA sola instancia por página,
      fuera de pantalla. HighlightsManager reescribe su contenido y la
      rasteriza para cada descarga (ver src/lib/shareCard.ts). */}
  <ShareCardTemplate />
</Layout>

<style>
  .page {
    max-width: 44rem;
    margin: 0 auto;
    padding: 2rem 1.5rem 5rem;
  }

  .page-header {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 2.75rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--border);
  }

  /* Botón de inicio: mismo lenguaje que ReaderHeader (ícono de contorno). */
  .btn-home {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-left: -0.6rem;
    color: var(--text-secondary);
    transition: color 0.15s ease;
  }
  .btn-home:hover {
    color: var(--accent);
  }
  .btn-home:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 2px;
  }
  .btn-home svg {
    width: 1.4rem;
    height: 1.4rem;
  }

  .page-title {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 5.5vw, 2.6rem);
    font-weight: 600;
    line-height: 1.1;
    color: var(--text);
    margin: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .btn-home {
      transition: none;
    }
  }
</style>

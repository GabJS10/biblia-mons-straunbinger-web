---
import Layout from "../layouts/Layout.astro";
import BookPickerModal from "../components/BookPickerModal.astro";
import { getBookCatalog } from "../lib/bookCatalog";

// Catálogo compartido: bookOrder × colección `books` × colección `intros`.
const books = await getBookCatalog();
---

<Layout>
  <main class="home">
    <h1>Biblia Straubinger</h1>
   <p class="lead">
  Un espacio para leer la Biblia según la traducción del Mons. Juan
  Straubinger, con sus comentarios y notas originales, pensado para la
  lectura diaria.
  <br>
  <small class="text-muted fst-italic" >
    Creado por <a target="_blank" rel="noopener noreferrer" href="https://www.linkedin.com/in/gabriel-ballesteros-3114b916a/">Gabriel Ballesteros</a>
  </small>
</p> 

    <div class="actions">
      <button type="button" class="btn-primary" data-open-picker>Elegir libro</button>
      <a class="link-secondary" href="/prologo/">Prólogo</a>
    </div>
  </main>

  <BookPickerModal books={books} />
</Layout>

<style>
  .home {
    max-width: 42rem;
    margin: 0 auto;
    padding: 7rem 1.5rem;
    text-align: center;
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.4rem, 7vw, 3.6rem);
    line-height: 1.05;
    margin: 0 0 1.5rem;
    color: var(--text);
  }

  .lead {
    font-family: var(--font-body);
    font-size: 1.3rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0 auto 3.5rem;
    max-width: 34rem;
  }

  .actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  /* Acción principal con estilo de CONTORNO (no píldora rellena). */
  .btn-primary {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    background: transparent;
    border: 1px solid var(--accent);
    border-radius: 2px;
    padding: 0.85rem 2.5rem;
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .btn-primary:hover {
    background: var(--accent);
    color: var(--bg);
  }

  .link-secondary {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-secondary);
    text-decoration: none;
  }
  .link-secondary:hover {
    color: var(--accent);
  }
</style>

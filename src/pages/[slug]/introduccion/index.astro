---
/**
 * Introducción de un libro: `/[slug]/introduccion/`.
 *
 * Solo se genera para los libros que tienen una entrada en la colección `intros`
 * con `book === slug`. El Markdown se renderiza con `render()` de content
 * collections. El prólogo general (intro sin `book`) vive en `/prologo/`.
 */
import { getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import ReaderHeader from '../../../components/ReaderHeader.astro';
import ChapterNav from '../../../components/ChapterNav.astro';
import { getAdjacent } from '../../../lib/readingSequence';

export async function getStaticPaths() {
  const intros = await getCollection('intros');
  return intros
    .filter((entry) => Boolean(entry.data.book))
    .map((entry) => ({
      params: { slug: entry.data.book! },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { prev, next } = await getAdjacent(Astro.url.pathname);
---

<Layout title={`${entry.data.title} — Biblia Straubinger`}>
  <div class="reader">
    <ReaderHeader eyebrow="Introducción" title={entry.data.title} />

    <main class="reader-body prose">
      <Content />
    </main>

    {/* Navegación de lectura: flechas fijas (desktop) + barra final (móvil). */}
    <ChapterNav prev={prev} next={next} />
  </div>
</Layout>

<style>
  .reader {
    max-width: 44rem;
    margin: 0 auto;
    padding: 2rem 1.5rem 5rem;
  }

  /* Cuerpo en serif para lectura prolongada. Escala con la preferencia del
     usuario (A- / A+), igual que los versículos: es el mismo tipo de contenido
     de lectura larga. */
  .prose {
    font-family: var(--font-body);
    font-size: calc(1.25rem * var(--verse-font-scale));
    line-height: 1.8;
    color: var(--text);
  }
  .prose :global(a) {
    color: var(--accent);
  }
</style>

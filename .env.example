# Credenciales del proyecto Supabase (cliente, sitio estático).
#
# Copia este archivo a `.env` y completa los valores reales. El `.env` está en
# .gitignore y NO debe subirse al repositorio.
#
# Dónde obtenerlas en el dashboard de Supabase:
#   Project Settings → API
#     - PUBLIC_SUPABASE_URL      → "Project URL"
#     - PUBLIC_SUPABASE_ANON_KEY → "Project API keys" → clave "anon" / "public"
#
# El prefijo PUBLIC_ es intencional: Astro solo expone al navegador las
# variables con ese prefijo, y la clave anon es pública por diseño.

PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
